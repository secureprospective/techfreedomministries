---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/accents.css';
import '../styles/responsive.css';
import BrevoSignup from '../components/BrevoSignup.jsx';

const { title = "Tech Freedom Ministries — Break from the digital grid.", hideNewsletter = false } = Astro.props;
const { pathname } = Astro.url;

const navLinks = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/vanguard', label: 'Vanguard' },
  { href: '/donate',  label: 'Give' },
  { href: '/about',   label: 'About' },
];

const footerLinks = [
  { href: '/events',  label: 'Events' },
  ...navLinks,
  { href: '/oath',    label: 'The Oath' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Free events. Real tools. Teaching people to escape Big Tech surveillance — for free." />
    <title>{title}</title>
  </head>
  <body>

    <!-- Gilded Spine: fixed structural elements -->
    <div class="tfm-spine" aria-hidden="true"></div>
    <div class="tfm-ribbon" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-inner">

        <!-- Colophon: diamond ornament + Cinzel wordmark -->
        <a href="/" class="colophon-link" aria-label="Tech Freedom Ministries — Home">
          <img
            src="/assets/tfm-logo-on-white-zero.png"
            alt="Tech Freedom Ministries"
            class="header-logo-mark"
          />
          <div class="colophon-ornament">
            <div class="colophon-rule colophon-rule--left"></div>
            <span class="colophon-diamond" aria-hidden="true">◆</span>
            <div class="colophon-rule colophon-rule--right"></div>
          </div>
          <div class="colophon-wordmark">Tech Freedom Ministries</div>
        </a>

        <nav class="site-nav">
          {navLinks.map((link, i) => (
            <>
              {i > 0 && <span class="diamond" aria-hidden="true">◆</span>}
              <a
                href={link.href}
                class:list={['nav-link', { active: pathname === link.href || pathname.startsWith(link.href + '/') }]}
              >
                {link.label}
              </a>
            </>
          ))}
        </nav>

        <a href="/events" class="header-cta">Find an event</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      {!hideNewsletter && (
        <div class="footer-email-row">
          <BrevoSignup client:visible />
        </div>
      )}
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/assets/tfm-logo-nearblack.png" alt="" class="footer-logo" />
          <span class="footer-wordmark">Tech Freedom Ministries</span>
          <p class="footer-galatians tfm-ref-mark">
            For freedom Christ has set us free.<br />Galatians 5:1
          </p>
        </div>

        <nav class="footer-nav">
          {footerLinks.map((link, i) => (
            <>
              {i > 0 && <span class="diamond" aria-hidden="true">◆</span>}
              <a href={link.href} class="footer-link">{link.label}</a>
            </>
          ))}
        </nav>

        <div class="footer-meta">
          <span class="footer-copy">© 2026 Tech Freedom Ministries</span>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  html {
    overflow-x: hidden;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--tfm-parchment);
    color: var(--tfm-near-black);
    font-family: var(--tfm-sans);
    min-height: 100vh;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main { flex: 1; }

  /* ── Gilded Spine: Fixed structural elements ── */
  .tfm-spine {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(180deg,
      var(--tfm-gilt-deep) 0%,
      var(--tfm-gilt) 35%,
      var(--tfm-gilt-deep) 65%,
      var(--tfm-gilt) 85%,
      var(--tfm-gilt-deep) 100%
    );
    z-index: 200;
    pointer-events: none;
  }

  .tfm-ribbon {
    position: fixed;
    right: 48px;
    top: 0;
    width: 18px;
    height: 216px;
    background: linear-gradient(180deg, var(--tfm-crimson-deep) 0%, var(--tfm-crimson) 100%);
    clip-path: polygon(0 0, 100% 0, 100% 82%, 50% 100%, 0 82%);
    z-index: 100;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .tfm-spine { display: none; }
    .tfm-ribbon { display: none; }
  }

  /* ── Header — Dark Leather ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--tfm-leather);
    background-image:
      repeating-linear-gradient(45deg, transparent, transparent 18px, rgba(196,168,74,0.03) 18px, rgba(196,168,74,0.03) 19px),
      repeating-linear-gradient(-45deg, transparent, transparent 18px, rgba(196,168,74,0.03) 18px, rgba(196,168,74,0.03) 19px);
    border-bottom: 1px solid rgba(196,168,74,0.35);
    min-height: 56px;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ── Colophon ── */
  .colophon-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
  }

  .colophon-ornament {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .colophon-rule {
    height: 1px;
    width: 48px;
    flex-shrink: 0;
  }

  .colophon-rule--left {
    background: linear-gradient(to right, transparent, var(--tfm-gilt));
  }

  .colophon-rule--right {
    background: linear-gradient(to left, transparent, var(--tfm-gilt));
  }

  .colophon-diamond {
    color: var(--tfm-gilt);
    font-size: 10px;
    line-height: 1;
  }

  .colophon-wordmark {
    font-family: var(--tfm-cinzel);
    font-size: 20px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(244, 240, 230, 0.92);
    white-space: nowrap;
  }

  /* ── Nav on leather ── */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nav-link {
    font-family: var(--tfm-sans);
    font-size: 11px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: rgba(244, 240, 230, 0.70);
    text-decoration: none;
    font-weight: 400;
    transition: color 220ms cubic-bezier(.2,0,.2,1);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--tfm-parchment);
    font-weight: 500;
  }

  .diamond {
    color: rgba(196, 168, 74, 0.55);
    font-size: 8px;
    line-height: 1;
  }

  .header-cta {
    font-family: var(--tfm-sans);
    font-size: 12px;
    font-weight: 500;
    padding: 9px 18px;
    background: rgba(196, 168, 74, 0.14);
    color: var(--tfm-parchment);
    text-decoration: none;
    border: 1px solid rgba(196, 168, 74, 0.5);
    border-radius: 2px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: all 220ms cubic-bezier(.2,0,.2,1);
  }

  .header-cta:hover {
    background: rgba(196, 168, 74, 0.24);
    border-color: rgba(196, 168, 74, 0.8);
    color: #fff;
  }

  /* ── Footer ── */
  .site-footer {
    border-top: 1px solid var(--tfm-parchment-edge);
    background: var(--tfm-parchment);
    padding: 48px 36px 40px;
  }

  .footer-email-row {
    max-width: 1100px;
    margin: 0 auto;
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--tfm-parchment-edge);
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 48px;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-logo {
    width: 80px;
    height: auto;
  }

  .footer-wordmark {
    font-family: var(--tfm-sans);
    font-size: 11px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--tfm-gold-muted-on-light);
  }

  .footer-galatians {
    font-family: var(--tfm-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--tfm-warm-brown);
    line-height: 1.55;
    margin: 0;
    max-width: 32ch;
  }

  .footer-nav {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-link {
    font-family: var(--tfm-sans);
    font-size: 11px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--tfm-gold-muted-on-light);
    text-decoration: none;
    transition: color 220ms cubic-bezier(.2,0,.2,1);
  }

  .footer-link:hover { color: var(--tfm-near-black); }

  .footer-meta {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-copy {
    font-family: var(--tfm-sans);
    font-size: 11px;
    letter-spacing: 0.10em;
    color: var(--tfm-warm-brown-soft);
  }

  /* ── Desktop: hide the header logo mark (mobile only) ── */
  @media (min-width: 769px) {
    .header-logo-mark {
      display: none;
    }
  }

  /* ── Mobile: 768px and below ── */
  @media (max-width: 768px) {

    /* Header shell */
    .site-header {
      min-height: 48px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      background-color: var(--tfm-leather);
      border-bottom: 1px solid rgba(196, 168, 74, 0.35);
    }

    /* Header inner: logo left, nav right, single row */
    .header-inner {
      min-height: 48px;
      padding: 0 16px 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      max-width: none;
    }

    /* Colophon: hide wordmark and ornament, show logo mark only */
    .colophon-ornament { display: none; }
    .colophon-wordmark { display: none; }

    .colophon-link {
      flex-direction: row;
      gap: 0;
      flex-shrink: 0;
    }

    .header-logo-mark {
      display: block;
      height: 32px;
      width: auto;
    }

    /* Desktop CTA button: hide on mobile */
    .header-cta { display: none; }

    /* Nav: remove diamond separators */
    .site-nav .diamond { display: none; }

    /* Nav: tight right-aligned row */
    .site-nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    /* Nav links */
    .nav-link {
      font-family: var(--tfm-sans);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--tfm-gold-muted-on-dark);
      white-space: nowrap;
    }

    /* Events link — primary visual anchor */
    .site-nav .nav-link:first-of-type { color: var(--tfm-gold-deep); }

    /* Active state */
    .nav-link.active {
      color: var(--tfm-parchment);
      font-weight: 500;
    }

    /* Push page content below fixed header */
    body { padding-top: 48px; }

    /* Spine and ribbon: hide on mobile per TFM_11 */
    .tfm-spine  { display: none; }
    .tfm-ribbon { display: none; }

    /* Footer shell */
    .site-footer { padding: 32px 20px; }

    /* Email signup row */
    .footer-email-row {
      padding-bottom: 28px;
      margin-bottom: 28px;
    }

    /* Footer inner: single column, centered */
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 24px;
      text-align: center;
    }

    /* Brand block */
    .footer-brand { align-items: center; }
    .footer-logo  { margin: 0 auto; }

    /* Nav and meta */
    .footer-nav  { justify-content: center; }
    .footer-meta { text-align: center; align-items: center; }

  }
</style>
